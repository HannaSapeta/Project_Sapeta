<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfUI.ViewModels"
        mc:Ignorable="d"
        Title="Менеджер медіафайлів"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel Margin="10">

        <Border DockPanel.Dock="Top"
                Background="#EAEAEA"
                Padding="10"
                Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <Button Content="➕ Додати фото"
                        Width="140"
                        Height="35"
                        Margin="0,0,10,0"
                        Command="{Binding AddCommand}" />

                <Button Content="🗑 Видалити"
                        Width="120"
                        Height="35"
                        Command="{Binding DeleteCommand}" />

            </StackPanel>

        </Border>

        <DataGrid ItemsSource="{Binding Photos}"
                  SelectedItem="{Binding SelectedPhoto}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  x:Name="mediaGrid"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Назва файлу"
                    Binding="{Binding FileName}"
                    Width="*" />

                <DataGridTextColumn
                    Header="Розмір (MB)"
                    Binding="{Binding FileSizeMb}"
                    Width="150" />

                <DataGridTextColumn
                    Header="Роздільна здатність"
                    Binding="{Binding Resolution}"
                    Width="200" />

            </DataGrid.Columns>

        </DataGrid>

        <StatusBar DockPanel.Dock="Bottom">

            <StatusBarItem>
                <TextBlock Text="{Binding Photos.Count,
                          StringFormat=Кількість фото: {0}}" />
            </StatusBarItem>

        </StatusBar>

    </DockPanel>

</Window>